{
  "tags": [
    {
      "id": "narrative_choice_translation",
      "type": "dynamicText",
      "regex": "<choice_it scene=\"(\\d+)\"\\s+progressivo=\"(\\d+)\">([^<]*)<\/choice_it>",
      "replacement": null,
      "parameters": [
        { "name": "sceneId", "value": "{captured_value_from_regex_1}" },
        { "name": "progressiveId", "value": "{captured_value_from_regex_2}" },
        { "name": "italianText", "value": "{captured_value_from_regex_3}" }
      ],
      "actor": "DM",
      "command": "updateChoiceText",
      "replace": true
    },
    {
      "id": "discipline_choice_translation",
      "type": "dynamicText",
      "regex": "<DISCIPLINE_IT id=\\\"([^\\\"]*)\\\">([^<]*)<\/discipline_it>",
      "replacement": null,
      "parameters": [
        { "name": "id", "value": "{captured_value_from_regex_1}" },
        { "name": "italianText", "value": "{captured_value_from_regex_2}" }
      ],
      "actor": "DM",
      "command": "updateDisciplineChoiceText",
      "replace": true
    }
  ]
}